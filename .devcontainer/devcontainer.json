{
  "name": "toy-kubernetes",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "dockerDashComposeVersion": "none",
      "installDockerBuildx": false
    }
  },
  "privileged": true,
  "remoteUser": "root",
  "containerUser": "root",
  "postCreateCommand": "git config --global --add safe.directory /workspaces/toy-kubernetes",
  "workspaceFolder": "/workspaces/toy-kubernetes",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-vscode.cpptools"
      ]
    }
  }
}
